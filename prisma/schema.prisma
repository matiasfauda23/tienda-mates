generator client {
  provider = "prisma-client-js"
}

// Acá está la clave: el provider DEBE ser "postgresql"
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id          String   @id @default(uuid())
  nombre      String
  slug        String   @unique
  descripcion String
  precio      Float
  stock       Int      @default(0)
  
  fotos       String[] 
  colores     String[] 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}